{
  "_comment": "Copy to <project>/annotator.json and keep only what you change. Every key and its default is listed in config.py.",

  "sensor": "multiscan",
  "bags_root": "/path/to/your/rosbags",
  "default_topic": "/multiscan/lidar_scan",
  "lidar_frame": null,
  "port": 8765,
  "driver": null,

  "paths": { "ledger": "annotations.jsonl" },
